```
const html = $json["data"];

// Extract Title
const titleMatch = html.match(/<title>(.*?)<\/title>/i);
const title = titleMatch ? titleMatch[1] : "No Title Found";

// Extract Headings
const headings = [...html.matchAll(/<h[1-3][^>]*>(.*?)<\/h[1-3]>/gi)]
  .map(h => h[1].replace(/<[^>]*>/g, ""));

// Extract Links (limit 5)
const links = [...html.matchAll(/<a[^>]+href="(.*?)"[^>]*>(.*?)<\/a>/gi)]
  .slice(0, 5)
  .map(l => ({
    url: l[1],
    text: l[2].replace(/<[^>]*>/g, "") || l[1]
  }));

// Modern UI Output
const output = `
<div style="font-family: 'Segoe UI', sans-serif; padding:40px; background:#f4f7fb; min-height:100vh;">

  <div style="
    max-width:800px;
    margin:auto;
    background:white;
    border-radius:20px;
    box-shadow:0 10px 30px rgba(0,0,0,0.1);
    overflow:hidden;
  ">

    <div style="
      background:linear-gradient(135deg, #34c1c6, #4facfe);
      padding:30px;
      color:white;
    ">
      <h1 style="margin:0;">${title}</h1>
      <p style="opacity:0.9;">Website Analysis Report</p>
    </div>

    <div style="padding:25px;">

      <h3>📌 Headings</h3>
      <ul>
        ${headings.length 
          ? headings.map(h => `<li>${h}</li>`).join("") 
          : "<li>No headings found</li>"
        }
      </ul>

      <h3>🔗 Links</h3>
      <ul>
        ${links.length 
          ? links.map(l => `<li><a href="${l.url}" target="_blank">${l.text}</a></li>`).join("") 
          : "<li>No links found</li>"
        }
      </ul>

    </div>

    <div style="padding:15px; text-align:center; font-size:12px; color:#777;">
      Generated via n8n ⚡
    </div>

  </div>
</div>
`;

return [{ json: { html: output } }];
```
